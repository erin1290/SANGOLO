{
  "expo": {
    "name": "Sangolo",
    "slug": "sangolo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_sangolo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_sangolo.png",
        "backgroundColor": "#FBF8F3"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "sangolo",
    "extra": {
      "eas": {
        "projectId": "e42e7424-c4eb-4329-bc84-0e04f9f2fdb4"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
