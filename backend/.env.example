DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=False
# Remplacer IP_DU_PC par l'IP LAN actuelle du poste qui lance Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,IP_DU_PC

DB_NAME=sangolo
DB_USER=sangolo
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379

# E-mail (ne jamais versionner le vrai mot de passe d'application)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@example.org
EMAIL_HOST_PASSWORD=mot-de-passe-application
DEFAULT_FROM_EMAIL=Sangolo <notifications@example.org>
